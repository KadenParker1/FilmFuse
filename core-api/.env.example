# core-api environment variables (names only - never commit values).
# Locally, application-local.properties covers these; on Railway set them on the service.

# Supabase Postgres via the session pooler, e.g. jdbc:postgresql://<host>:5432/postgres?currentSchema=app
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Supabase Auth
SUPABASE_URL=
SUPABASE_JWKS_URI=
SUPABASE_ISSUER=
SUPABASE_SERVICE_ROLE_KEY=

# External services (later phases)
TMDB_API_KEY=
ML_SERVICE_URL=
ML_INTERNAL_KEY=

# HTTP
APP_CORS_ALLOWED_ORIGINS=
PORT=

# Email (Resend SMTP: host smtp.resend.com, port 2587, username resend, password = API key)
FILMFUSE_EMAIL_PROVIDER=
FILMFUSE_EMAIL_FROM_ADDRESS=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
