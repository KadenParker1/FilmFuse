# local | production
ENV=
# Shared secret; core-api sends it as the X-Internal-Key header. Required unless ENV=local, and then
# at least 32 characters (startup fails otherwise). Generate with: openssl rand -hex 32
ML_INTERNAL_KEY=
# Read-only Postgres role (ml_reader) via the Supabase session pooler. Optional for now.
ML_DATABASE_URL=
PORT=
# Request body cap in bytes (default 5242880 = 5 MiB); larger bodies get 413.
ML_MAX_BODY_BYTES=
