# Copy to .env.local and fill in. EXPO_PUBLIC_* values are baked into the bundle at build time,
# so never put secrets here (the anon key is public by design).
#
# Local dev: localhost / 127.0.0.1 URLs are rewritten in development to the dev machine's LAN IP
# that Metro was reached on (lib/devHost.ts), so the same values work in a browser, the iOS
# Simulator, an Android emulator and Expo Go on a phone on the same Wi-Fi.
#
# EAS builds don't read this file: each eas.json profile pulls these names from its EAS
# environment (`eas env:create --environment preview|production`), see docs/mobile-app-plan.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
